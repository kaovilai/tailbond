#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# server-up: mqvpn server started (home router, SERVER role, e.g. Flint 3).
# Env: TB_TUN, TB_SUBNET, TB_SUBNET6, TB_PORT, TB_DNS_IP.
#
# - firewall: UDP $TB_PORT open on the wan zone
# - network 'tailbond' on $TB_TUN, zone 'tailbond' forwarding to wan (the
#   wan zone's masquerade is the clients' internet NAT) and, with
#   server.allow_lan, to the home LAN
# - tailnet: forwarding tailbond <-> the zone holding tailscale0 (created as
#   'tailbond_ts' if the firmware has none), masquerade of $TB_SUBNET toward
#   it, and the subnet advertised with tailscale set --advertise-routes
# - tcp/8077 (agent: discovery + pair requests) open from the tailnet zone,
#   and tailnet tcp/80 redirected to the phone page (main.landing_port)
# - dnsmasq kept off $TB_TUN, so the agent's DNS forwarder can bind $TB_DNS_IP
. "${TB_LIB:-/usr/lib/tailbond/hook-lib.sh}"

port="${TB_PORT:-443}"
subnet="${TB_SUBNET:-10.77.0.0/24}"
wan="$(zone_of_network wan)" || wan=wan
lan="$(zone_of_network lan)" || lan=lan

ensure_network
commit_reload network network && log "network: removed legacy interface tailbond"
# Tearing that interface down also set the device down.
ip link set dev "$TB_TUN" up 2>/dev/null || true

# Clients may query the agent's DNS forwarder and ping the server; nothing else.
ensure_zone REJECT
uset firewall.tailbond_dns rule
uset firewall.tailbond_dns.name tailbond-dns
uset firewall.tailbond_dns.src tailbond
uset firewall.tailbond_dns.proto 'tcp udp'
uset firewall.tailbond_dns.dest_port 53
uset firewall.tailbond_dns.target ACCEPT
uset firewall.tailbond_icmp rule
uset firewall.tailbond_icmp.name tailbond-icmp
uset firewall.tailbond_icmp.src tailbond
uset firewall.tailbond_icmp.proto icmp
uset firewall.tailbond_icmp.target ACCEPT
# Bonded routers/phones fetch the tailnet machines list (GET /api/peers,
# client token) from the agent on the tunnel IP; the agent answers nothing
# else on tunnel addresses.
uset firewall.tailbond_peers rule
uset firewall.tailbond_peers.name tailbond-peers
uset firewall.tailbond_peers.src tailbond
uset firewall.tailbond_peers.proto tcp
uset firewall.tailbond_peers.dest_port "$(tbcfg_or main.api_port 8077)"
uset firewall.tailbond_peers.target ACCEPT

uset firewall.tailbond_wan_in rule
uset firewall.tailbond_wan_in.name tailbond-mqvpn
uset firewall.tailbond_wan_in.src "$wan"
uset firewall.tailbond_wan_in.proto udp
uset firewall.tailbond_wan_in.dest_port "$port"
uset firewall.tailbond_wan_in.target ACCEPT

ensure_forwarding tailbond_wan tailbond "$wan"
if is_true "$(tbcfg_or server.allow_lan 1)"; then
	ensure_forwarding tailbond_lan tailbond "$lan"
else
	udel firewall.tailbond_lan
fi

# Tailnet. GL firmware's Tailscale may or may not put tailscale0 in a zone.
ts="$(zone_of_network tailscale0)" || ts="$(zone_of_network tailscale)" || {
	ts=tailbond_ts
	uset firewall.tailbond_ts zone
	uset firewall.tailbond_ts.name tailbond_ts
	uset firewall.tailbond_ts.device tailscale0
	uset firewall.tailbond_ts.input REJECT
	uset firewall.tailbond_ts.output ACCEPT
	uset firewall.tailbond_ts.forward REJECT
}
# Routers and phones on the tailnet find this server and ask to pair on
# the agent's port (GET /api/hello, POST /api/pair-requests).
uset firewall.tailbond_api rule
uset firewall.tailbond_api.name tailbond-pairing
uset firewall.tailbond_api.src "$ts"
uset firewall.tailbond_api.proto tcp
uset firewall.tailbond_api.dest_port "$(tbcfg_or main.api_port 8077)"
uset firewall.tailbond_api.target ACCEPT
# The phone page: http://<this router's Tailscale name>/ from the tailnet
# lands on the agent's landing port (GL's nginx keeps port 80 elsewhere).
landing="$(tbcfg_or main.landing_port 8078)"
# Only traffic to this router's own Tailscale address: LAN addresses reached
# over the tailnet (the 192.168.8.0/24 subnet route) must keep GL's admin UI.
ts4="$(tailscale ip -4 2>/dev/null | head -n1)"
[ -n "$ts4" ] || landing=0
if [ "$landing" = 0 ]; then
	udel firewall.tailbond_landing
	udel firewall.tailbond_landing_in
fi
if [ "$landing" != 0 ]; then
	uset firewall.tailbond_landing redirect
	uset firewall.tailbond_landing.name tailbond-phone-page
	uset firewall.tailbond_landing.src "$ts"
	uset firewall.tailbond_landing.proto tcp
	uset firewall.tailbond_landing.src_dip "$ts4"
	uset firewall.tailbond_landing.src_dport 80
	uset firewall.tailbond_landing.dest_port "$landing"
	uset firewall.tailbond_landing.target DNAT
	uset firewall.tailbond_landing_in rule
	uset firewall.tailbond_landing_in.name tailbond-phone-page-in
	uset firewall.tailbond_landing_in.src "$ts"
	uset firewall.tailbond_landing_in.proto tcp
	uset firewall.tailbond_landing_in.dest_port "$landing"
	uset firewall.tailbond_landing_in.target ACCEPT
else
	udel firewall.tailbond_landing
	udel firewall.tailbond_landing_in
fi
ensure_forwarding tailbond_to_ts tailbond "$ts"
ensure_forwarding tailbond_from_ts "$ts" tailbond
# Bonded clients are one tailnet device: NAT them to the server's tailnet IP.
uset firewall.tailbond_ts_nat nat
uset firewall.tailbond_ts_nat.name tailbond-tailnet-masq
uset firewall.tailbond_ts_nat.src "$ts"
uset firewall.tailbond_ts_nat.src_ip "$subnet"
uset firewall.tailbond_ts_nat.target MASQUERADE
uset firewall.tailbond_ts_nat.proto all
commit_reload firewall firewall && log "firewall: udp/$port open on $wan, zone tailbond -> $wan${lan:+/$lan}/$ts"

# The agent's DNS forwarder owns $TB_DNS_IP:53.
udel_list 'dhcp.@dnsmasq[0].notinterface' tailbond
ulist 'dhcp.@dnsmasq[0].notinterface' "$TB_TUN"
commit_reload dhcp dnsmasq && log "dnsmasq: no longer listening on $TB_TUN"

# Advertise the tunnel subnet, keeping routes advertised by others (GL UI).
if command -v tailscale >/dev/null && is_true "$(tbcfg_or server.advertise_routes 1)"; then
	routes="$(tailscale debug prefs 2>/dev/null | jsonfilter -e '@.AdvertiseRoutes[*]' 2>/dev/null | tr '\n' ' ')"
	case " $routes " in
	*" $subnet "*) ;;
	*)
		new="$(echo "$routes $subnet" | xargs | tr ' ' ',')"
		if tailscale set --advertise-routes="$new"; then
			log "tailscale: advertising $new (approve $subnet once in the admin console)"
		else
			log "tailscale: could not advertise $subnet"
		fi
		;;
	esac
fi

log "server-up: mqvpn on udp/$port, subnet $subnet via $TB_TUN"
exit 0
