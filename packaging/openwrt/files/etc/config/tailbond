# tailbond: WAN bonding to your own home server (mqvpn + tailbondd)
#
# Normally set from the GL admin panel (VPN -> tailbond). After
# editing by hand: /etc/init.d/tailbond restart. Empty options keep the
# value already in /etc/tailbond/tailbond.json (what the panel saved).

config tailbond 'main'
	# 'client' (travel router, e.g. Slate 7) or 'server' (home, e.g. Flint 3).
	# First install picks 'server' on a Flint 3 (GL-BE9300), else 'client'.
	option role 'client'
	# The agent runs right after install so the admin panel can pair; the
	# tunnel itself starts once paired.
	option enabled '1'
	# speed | streaming | redundant | failover
	option mode 'speed'
	# Agent listen address. Empty: client role 127.0.0.1:8077 (the GL panel
	# talks to it locally), server role 127.0.0.1 + its Tailscale IP.
	option listen ''
	# Client role: also serve tailbond's own page on the LAN at :8077
	# (advanced/debug; the GL admin panel needs none of it)
	option lan_dashboard '0'
	# Server role: port of the phone page ("Get tailbond", http://<name>/
	# on the Tailscale name; tailnet tcp/80 is redirected here). 0 = off.
	option landing_port '8078'
	# Password for the :8077 page; empty = keep the one in tailbond.json
	option ui_password ''
	option hooks_dir '/usr/lib/tailbond/hooks'
	option state_dir '/etc/tailbond/state'

config server 'server'
	# UDP port mqvpn listens on (opened on the wan zone by the server-up hook)
	option port '443'
	# Public address or DDNS name put in pairing links
	option public_addr ''
	option subnet '10.77.0.0/24'
	option subnet6 'fd77:77::/112'
	option use_tailscale_cert '1'
	# Advertise the tunnel subnet to the tailnet (tailscale set --advertise-routes)
	option advertise_routes '1'
	# Withdraw that route again when the server stops
	option withdraw_routes_on_stop '0'
	# Let bonded clients reach the home LAN (forwarding tailbond -> lan)
	option allow_lan '1'

config client 'client'
	# tailbond://pair?d=... from the server; empty = keep the imported one
	option pairing_uri ''
	# Block LAN traffic while the tunnel drops instead of falling back to
	# the WANs (kill switch). Turning tailbond off always releases the LAN.
	option kill_switch '1'
	# LAN networks routed through the tunnel
	list lan_network 'lan'
	# Point dnsmasq at the tunnel DNS (10.77.0.1) while connected
	option tunnel_dns '1'
	# ip rule priority base for the LAN policy routing (uses base-1 .. base+1)
	option rule_priority '1077'
	# Routing table for LAN traffic through the tunnel
	option route_table '77'
	# Captive portals (hotel/airport Wi-Fi, hotspots that want a sign-in):
	# check each WAN, keep one behind a portal out of bonding until signed
	# in, and offer a sign-in mode in the panel. On the repeater, GL's own
	# portal detection (Login Mode for Public Hotspots) is used when present.
	option captive_portal_detect '1'
	# Check URLs (plain http); default: Google's generate_204, then
	# Firefox's success.txt
	#list captive_probe_url 'http://connectivitycheck.gstatic.com/generate_204'
	# Routing table used while signing in to a portal
	option portal_table '78'

# WANs need no configuration: every network in the firewall's wan zone
# (GL: wan, wwan = repeater, tethering, modem_* = cellular, secondwan) is
# detected and used. The panel saves per-WAN choices (use, backup only,
# monthly data limit) in tailbond.json. To pin them here instead, add one
# section per OpenWrt network name, e.g.:
#
# config path
#	option iface 'tethering'
#	option enabled '1'
#	# primary | secondary | backup
#	option priority 'backup'
#	# backup paths drop out after this many MB a month (0 = no cap)
#	option data_cap_mb '5000'
