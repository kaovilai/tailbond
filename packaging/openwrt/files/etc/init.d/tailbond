#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
#
# tailbond: tailbondd agent supervising mqvpn (client or server role).
# Config: /etc/config/tailbond (UCI) -> /etc/tailbond/tailbond.json.

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/tailbondd
CONF=/etc/tailbond/tailbond.json
HOOKS=/usr/lib/tailbond/hooks

role() { uci -q get tailbond.main.role || echo client; }

paired_and_on() {
	[ -n "$(jsonfilter -i "$CONF" -e '@.client.pairing_uri' 2>/dev/null)" ] &&
		[ "$(jsonfilter -i "$CONF" -e '@.client.disconnected' 2>/dev/null)" != true ]
}

start_service() {
	[ "$(uci -q get tailbond.main.enabled)" = 1 ] || {
		echo "tailbond is turned off (VPN -> tailbond in the admin panel)"
		return 0
	}
	/usr/lib/tailbond/render-config || return 1
	mkdir -p "$(uci -q get tailbond.main.state_dir || echo /etc/tailbond/state)"

	# Kill switch: block LAN -> WAN before the tunnel is up for the first
	# time, but only once paired and switched on (a fresh install keeps the
	# LAN online while you pair from the admin panel).
	if [ "$(role)" = client ]; then
		if paired_and_on; then
			TB_TUN=tb0 "$HOOKS/client-down" >/dev/null 2>&1
		else
			TB_RELEASE=1 TB_TUN=tb0 "$HOOKS/client-down" >/dev/null 2>&1
		fi
	fi

	procd_open_instance
	procd_set_param command "$PROG" -config "$CONF" -quiet
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/tailbond
	procd_close_instance
}

# After the agent (and its down hooks) are gone: LAN back on the WANs,
# whatever the kill switch says, since the user stopped the service.
service_stopped() {
	[ "$(role)" = client ] && TB_RELEASE=1 TB_TUN=tb0 "$HOOKS/client-down" >/dev/null 2>&1
	return 0
}

service_triggers() {
	procd_add_reload_trigger tailbond
}

reload_service() {
	stop
	start
}
