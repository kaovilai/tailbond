#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# A WAN went up or down (repeater joined, phone plugged in, modem online):
# tell tailbondd to re-check its connections now instead of within 5 s.
case "$ACTION" in ifup | ifdown | ifupdate) ;; *) exit 0 ;; esac
case "$INTERFACE" in lan | loopback | tailbond) exit 0 ;; esac
pid="$(pidof tailbondd 2>/dev/null)"
[ -n "$pid" ] && kill -HUP "$pid" 2>/dev/null
exit 0
