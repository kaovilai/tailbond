#!/bin/sh
# Not while building a firmware image (IPKG_INSTROOT set): first boot runs
# the uci-defaults script then.
[ -n "$IPKG_INSTROOT" ] && exit 0
if [ -f /etc/uci-defaults/90-tailbond ]; then
	sh /etc/uci-defaults/90-tailbond && rm -f /etc/uci-defaults/90-tailbond
fi
# Survive firmware upgrades: a kept copy of the reinstall script plus a
# line in the kept /etc/rc.local (docs/glinet.md, "Firmware upgrades").
/usr/lib/tailbond/pkg-cache install-reinstall
/usr/lib/tailbond/pkg-cache rc-local-add
# Running right away: the admin panel (VPN -> tailbond) talks to
# the agent to pair. The tunnel starts once paired.
/etc/init.d/tailbond enable
/etc/init.d/tailbond restart
# GL admin panel: nginx caches /rpc modules per worker and reads
# gl-conf.d at load; the menu itself is re-read on every page load.
if [ -x /etc/init.d/nginx ] && nginx -t >/dev/null 2>&1; then
	/etc/init.d/nginx reload >/dev/null 2>&1
fi
# LuCI menu cache
rm -f /tmp/luci-indexcache* 2>/dev/null
[ -x /etc/init.d/rpcd ] && /etc/init.d/rpcd reload 2>/dev/null
exit 0
