<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the emulator end-to-end test's status/pair hook
     (debug/E2eReceiver.kt). DUMP: only adb's shell (and the system) may send to it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="dev.tailbond.app.debug.E2eReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.tailbond.app.debug.STATUS" />
                <action android:name="dev.tailbond.app.debug.PAIR" />
                <action android:name="dev.tailbond.app.debug.SHARE" />
                <action android:name="dev.tailbond.app.debug.HUB" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
