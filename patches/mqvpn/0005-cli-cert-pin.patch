diff --git a/src/platform/cert_pin.c b/src/platform/cert_pin.c
new file mode 100644
index 0000000..79504ad
--- /dev/null
+++ b/src/platform/cert_pin.c
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 mp0rta and mqvpn contributors
+
+/* Server certificate pin for the CLI client; see cert_pin.h. */
+
+#include "cert_pin.h"
+#include "log.h"
+
+#include <openssl/mem.h> /* CRYPTO_memcmp */
+#include <openssl/sha.h>
+
+#include <string.h>
+
+static int
+hexval(char c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+int
+mqvpn_cert_pin_parse(const char *s, uint8_t out[MQVPN_CERT_PIN_LEN])
+{
+    uint8_t pin[MQVPN_CERT_PIN_LEN];
+    size_t n = 0;
+    if (!s) return -1;
+    while (*s) {
+        if (*s == ':') {
+            /* only between bytes: not leading, trailing or doubled */
+            if (n == 0 || s[1] == '\0' || s[1] == ':') return -1;
+            s++;
+            continue;
+        }
+        int hi = hexval(s[0]);
+        int lo = hi < 0 ? -1 : hexval(s[1]);
+        if (hi < 0 || lo < 0 || n == MQVPN_CERT_PIN_LEN) return -1;
+        pin[n++] = (uint8_t)(hi << 4 | lo);
+        s += 2;
+    }
+    if (n != MQVPN_CERT_PIN_LEN) return -1;
+    for (size_t i = 0; i < MQVPN_CERT_PIN_LEN; i++)
+        out[i] = pin[i];
+    return 0;
+}
+
+int
+mqvpn_cert_pin_resolve(const char *cli, const char *file, int file_set,
+                       uint8_t out[MQVPN_CERT_PIN_LEN], int *pin_set, const char **src)
+{
+    uint8_t cli_pin[MQVPN_CERT_PIN_LEN], file_pin[MQVPN_CERT_PIN_LEN];
+    *pin_set = 0;
+    *src = NULL;
+    /* both sides are checked: a bad pin in the file is an error even when
+     * the command line brings a good one */
+    if (cli && mqvpn_cert_pin_parse(cli, cli_pin) < 0) {
+        *src = "--cert-sha256";
+        return -1;
+    }
+    if (file_set && mqvpn_cert_pin_parse(file ? file : "", file_pin) < 0) {
+        *src = "CertSHA256";
+        return -1;
+    }
+    if (!cli && !file_set) return 0;
+    memcpy(out, cli ? cli_pin : file_pin, MQVPN_CERT_PIN_LEN);
+    *src = cli ? "--cert-sha256" : "CertSHA256";
+    *pin_set = 1;
+    return 0;
+}
+
+int
+mqvpn_cert_pin_verify(const uint8_t *const certs[], const size_t cert_len[],
+                      size_t n_certs, const char *hostname, void *ctx)
+{
+    const uint8_t *pin = (const uint8_t *)ctx;
+    uint8_t digest[SHA256_DIGEST_LENGTH];
+    (void)hostname; /* the pin is the identity; no name check */
+    if (!pin || n_certs == 0 || !certs || !cert_len || !certs[0] || cert_len[0] == 0)
+        return -1;
+    SHA256(certs[0], cert_len[0], digest);
+    if (CRYPTO_memcmp(digest, pin, sizeof(digest)) != 0) {
+        LOG_ERR("TLS certificate rejected: leaf SHA-256 does not match the pinned "
+                "certificate (CertSHA256)");
+        return -1;
+    }
+    return 0;
+}
diff --git a/src/platform/cert_pin.h b/src/platform/cert_pin.h
new file mode 100644
index 0000000..81e1fad
--- /dev/null
+++ b/src/platform/cert_pin.h
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 mp0rta and mqvpn contributors
+
+/*
+ * Server certificate pin for the CLI client (--cert-sha256 / [Server]
+ * CertSHA256): the SHA-256 of the server's leaf certificate (DER). With a
+ * pin, the leaf must hash to it and nothing else is checked (no chain, no
+ * hostname): the pin is the server's identity, as for a self-signed server
+ * certificate. Installed through mqvpn_config_set_cert_verifier, so the
+ * library consults it on every handshake, reconnects included.
+ */
+#ifndef MQVPN_CERT_PIN_H
+#define MQVPN_CERT_PIN_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define MQVPN_CERT_PIN_LEN 32
+
+/* Parses 64 hex digits, any case, optionally ':'-separated between bytes
+ * (AB:CD:...). Returns 0 and fills out, or -1 (out untouched) on anything
+ * else. */
+int mqvpn_cert_pin_parse(const char *s, uint8_t out[MQVPN_CERT_PIN_LEN]);
+
+/* The pin to use, from the command line (cli: --cert-sha256's argument, NULL
+ * when not given) or the config file (file: CertSHA256, file_set: the key is
+ * present). The command line wins. A pin that is given, on either side, must
+ * be valid: empty or malformed is an error (-1, *src names the source),
+ * never "no pin", so it can't leave Insecure on or drop the file's pin; a
+ * bad file pin is an error even when the command line has a good one.
+ * Returns 0 with *pin_set 1 (out filled) or 0 (no pin given anywhere). */
+int mqvpn_cert_pin_resolve(const char *cli, const char *file, int file_set,
+                           uint8_t out[MQVPN_CERT_PIN_LEN], int *pin_set, const char **src);
+
+/* mqvpn_cert_verify_fn: ctx is the uint8_t[MQVPN_CERT_PIN_LEN] pin. Accepts
+ * only a chain whose leaf (certs[0]) hashes to the pin (constant-time
+ * compare). Returns 0 to accept, -1 to reject. */
+int mqvpn_cert_pin_verify(const uint8_t *const certs[], const size_t cert_len[],
+                          size_t n_certs, const char *hostname, void *ctx);
+
+#endif /* MQVPN_CERT_PIN_H */
