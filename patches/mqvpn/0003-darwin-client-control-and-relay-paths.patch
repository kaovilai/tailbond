diff -ruN a/src/platform/darwin/route_mon.c b/src/platform/darwin/route_mon.c
--- a/src/platform/darwin/route_mon.c	2026-11-03 18:45:19.263168594 -0500
+++ b/src/platform/darwin/route_mon.c	2026-11-03 18:53:45.865519682 -0500
@@ -88,9 +88,20 @@
  * PATH_CHALLENGE, or the challenge dies with ENETUNREACH (rationale at
  * darwin_scoped_server_pin). Best-effort: on failure keep today's behavior
  * and let xquic's challenge retransmits probe the route. */
+/* Relay paths (NAME@HOST:PORT) are named, not interfaces: no pin, no
+ * scoped server route, and no interface to watch. */
+static int
+route_slot_is_relay(const platform_ctx_t *p, const char *name)
+{
+    for (int i = 0; i < p->n_paths; i++)
+        if (p->paths[i].via_len && strcmp(p->paths[i].iface, name) == 0) return 1;
+    return 0;
+}
+
 void
 netmon_platform_pre_readd(platform_ctx_t *p, const char *ifname)
 {
+    if (route_slot_is_relay(p, ifname)) return;
     if (p->routing_configured) (void)darwin_scoped_server_pin(p, ifname);
 }
 
