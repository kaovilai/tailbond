diff --git a/src/mqvpn_internal.h b/src/mqvpn_internal.h
index 72fc8d0..9b6d5c4 100644
--- a/src/mqvpn_internal.h
+++ b/src/mqvpn_internal.h
@@ -413,4 +413,35 @@ MQVPN_INTERNAL int mqvpn_server_get_client_sched(const mqvpn_server_t *s,
