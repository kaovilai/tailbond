+    yyjson_val *clients = yyjson_obj_get(root, "clients");
+    CHECK(yyjson_arr_size(clients) == 1);
+    yyjson_val *c0 = yyjson_arr_get(clients, 0);
+    CHECK(yyjson_equals_str(yyjson_obj_get(c0, "user"), ""));
+    CHECK(yyjson_equals_str(yyjson_obj_get(c0, "endpoint"), "203.0.113.7:443"));
+    CHECK(yyjson_equals_str(yyjson_obj_get(c0, "scheduler"), "minrtt"));
+    CHECK(yyjson_get_uint(yyjson_obj_get(c0, "connected_sec")) == 42);
+    CHECK(yyjson_get_uint(yyjson_obj_get(c0, "bytes_tx")) == 1000);
+    CHECK(yyjson_get_uint(yyjson_obj_get(c0, "bytes_rx")) == 2000);
+    CHECK(yyjson_get_int(yyjson_obj_get(c0, "n_paths")) == 2);
+    yyjson_val *paths = yyjson_obj_get(c0, "paths");
+    CHECK(yyjson_arr_size(paths) == 2);
+
+    yyjson_val *jp0 = yyjson_arr_get(paths, 0);
+    CHECK(yyjson_equals_str(yyjson_obj_get(jp0, "iface"), "wan"));
+    CHECK(yyjson_equals_str(yyjson_obj_get(jp0, "status"), "active"));
+    CHECK(yyjson_get_uint(yyjson_obj_get(jp0, "srtt_ms")) == 31);
+    CHECK(yyjson_get_uint(yyjson_obj_get(jp0, "min_rtt_ms")) == 18);
+    CHECK(yyjson_get_uint(yyjson_obj_get(jp0, "bytes_tx")) == 600);
+    CHECK(yyjson_get_uint(yyjson_obj_get(jp0, "pkt_sent")) == 10);
+    CHECK(yyjson_get_uint(yyjson_obj_get(jp0, "pkt_recv")) == 20);
+    CHECK(yyjson_get_uint(yyjson_obj_get(jp0, "pkt_lost")) == 1);
+    CHECK(yyjson_equals_str(yyjson_obj_get(jp0, "state_label"), "active"));
+    CHECK(yyjson_get_uint(yyjson_obj_get(jp0, "reinject_tx_bytes")) == 9);
+
+    yyjson_val *jp1 = yyjson_arr_get(paths, 1);
