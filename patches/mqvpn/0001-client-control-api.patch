+int
+mqvpn_client_get_status_snapshot(const mqvpn_client_t *c,
+                                 mqvpn_internal_client_status_t *out)
+{
+    if (!c || !out) return -1;
+    memset(out, 0, sizeof(*out));
+    out->state = c->state;
+    out->scheduler = mqvpn_sched_to_name(c->config.scheduler);
+    uint64_t now = client_now_us(c);
+    if (c->state == MQVPN_STATE_ESTABLISHED && c->established_at_us > 0 &&
+        now > c->established_at_us)
+        out->connected_sec = (now - c->established_at_us) / 1000000;
+
+    char host[INET6_ADDRSTRLEN] = {0};
+    uint16_t port = 0;
+    if (c->server_addr.ss_family == AF_INET) {
+        const struct sockaddr_in *s4 = (const struct sockaddr_in *)&c->server_addr;
+        inet_ntop(AF_INET, &s4->sin_addr, host, sizeof(host));
+        port = ntohs(s4->sin_port);
+    } else if (c->server_addr.ss_family == AF_INET6) {
+        const struct sockaddr_in6 *s6 = (const struct sockaddr_in6 *)&c->server_addr;
+        inet_ntop(AF_INET6, &s6->sin6_addr, host, sizeof(host));
+        port = ntohs(s6->sin6_port);
+    }
+    if (host[0]) snprintf(out->endpoint, sizeof(out->endpoint), "%s:%u", host, port);
+
+    xqc_conn_stats_t xstats;
+    memset(&xstats, 0, sizeof(xstats));
+    if (c->engine && c->conn) xstats = xqc_conn_get_stats(c->engine, &c->conn->cid);
+
+    int count = c->n_paths < MQVPN_MAX_PATHS ? c->n_paths : MQVPN_MAX_PATHS;
+    for (int i = 0; i < count; i++) {
+        const path_entry_t *p = &c->paths[i];
+        mqvpn_internal_client_path_t *op = &out->paths[i];
+        mqvpn_path_stats_t *ps = &op->stats;
+        memcpy(op->iface, p->name, sizeof(op->iface));
+        op->iface[sizeof(op->iface) - 1] = '\0';
+        op->status = p->status;
+        ps->struct_size = sizeof(*ps);
+        ps->path_id = p->xqc_path_id;
+        ps->bytes_tx = p->bytes_tx;
+        ps->bytes_rx = p->bytes_rx;
+        ps->state = p->status == MQVPN_PATH_PENDING ? MQVPN_XQC_PATH_STATE_INIT
+                                                    : MQVPN_XQC_PATH_STATE_CLOSED;
+
+        const xqc_path_metrics_t *pm =
+            p->xquic_path_live ? xqc_find_path_metrics(&xstats, p->xqc_path_id) : NULL;
+        if (!pm) continue;
+        ps->srtt_us = pm->path_srtt;
+        ps->min_rtt_us = pm->path_min_rtt;
+        ps->cwnd = pm->path_cwnd;
+        ps->bytes_in_flight = pm->path_bytes_in_flight;
+        ps->bytes_tx = pm->path_send_bytes;
+        ps->bytes_rx = pm->path_recv_bytes;
+        ps->pkt_sent = pm->path_pkt_send_count;
+        ps->pkt_recv = pm->path_pkt_recv_count;
+        ps->pkt_lost = pm->path_lost_count;
+        ps->state = pm->path_state;
+        op->reinject_tx_bytes = pm->path_send_reinject_bytes;
+        out->bytes_tx += pm->path_send_bytes;
+        out->bytes_rx += pm->path_recv_bytes;
+    }
+    out->n_paths = count;
+    free(xstats.paths_info);
+    return 0;
+}
