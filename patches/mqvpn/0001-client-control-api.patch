                                                  int max);
 
+/* Client-side counterpart of mqvpn_server_get_client_info() for the control
+ * API in client mode: this connection as one client entry. Side channel like
+ * the reinject snapshot (the public mqvpn_path_info_t carries no min_rtt /
+ * packet counters, and mqvpn_path_stats_t cannot grow an iface name).
+ *
+ * paths[] holds every slot mqvpn_client_get_paths() lists, in slot order.
+ * Slots with a live xquic path carry its metrics; the others keep path_id =
+ * the slot's last xquic path id, the platform byte counters, and state INIT
+ * (PENDING) or CLOSED (everything else). */
+typedef struct {
+    char iface[16]; /* bound interface, "" = unpinned */
+    int status;     /* mqvpn_path_status_t */
+    uint64_t reinject_tx_bytes;
+    mqvpn_path_stats_t stats;
+} mqvpn_internal_client_path_t;
+
+typedef struct {
+    int state;              /* mqvpn_client_state_t */
+    uint64_t connected_sec; /* time in ESTABLISHED, 0 otherwise */
+    char endpoint[64];      /* server address "ip:port" */
+    const char *scheduler;  /* this client's scheduler name */
+    uint64_t bytes_tx;      /* sum over the live xquic paths */
+    uint64_t bytes_rx;
+    int n_paths;
+    mqvpn_internal_client_path_t paths[MQVPN_MAX_PATHS];
+} mqvpn_internal_client_status_t;
+
+/* 0 = *out filled, -1 = NULL argument. */
+MQVPN_INTERNAL int mqvpn_client_get_status_snapshot(const mqvpn_client_t *c,
+                                                    mqvpn_internal_client_status_t *out);
+
 #endif /* MQVPN_INTERNAL_H */
