+static const char *const ctrl_client_state_names[] = {
+    "idle",        "connecting",   "authenticating", "tunnel_ready",
+    "established", "reconnecting", "closed",
+};
+
+/* get_status in client mode: the server's shape with this connection as the
+ * only client. */
+static int
+ctrl_client_get_status(char *resp, size_t resp_len, ctrl_socket_t *cs)
+{
+    mqvpn_internal_client_status_t cst;
+    if (mqvpn_client_get_status_snapshot(cs->client, &cst) < 0)
+        return ctrl_error(resp, resp_len, "internal error");
+
+    yyjson_mut_doc *doc = yyjson_mut_doc_new(NULL);
+    yyjson_mut_val *root = yyjson_mut_obj(doc);
+    yyjson_mut_doc_set_root(doc, root);
+    bool ok = yyjson_mut_obj_add_bool(doc, root, "ok", true);
+    ok &= yyjson_mut_obj_add_str(doc, root, "state",
+                                 cst.state >= 0 && cst.state < MQVPN_STATE__COUNT
+                                     ? ctrl_client_state_names[cst.state]
+                                     : "unknown");
+    ok &= yyjson_mut_obj_add_int(doc, root, "n_clients", 1);
+    yyjson_mut_val *jclients = yyjson_mut_obj_add_arr(doc, root, "clients");
+    yyjson_mut_val *jc = yyjson_mut_arr_add_obj(doc, jclients);
+    ok &= jc != NULL;
+    ok &= yyjson_mut_obj_add_str(doc, jc, "user", "");
+    ok &= yyjson_mut_obj_add_strcpy(doc, jc, "endpoint", cst.endpoint);
+    ok &= yyjson_mut_obj_add_strcpy(doc, jc, "scheduler",
+                                    cst.scheduler ? cst.scheduler : "unknown");
+    ok &= yyjson_mut_obj_add_uint(doc, jc, "connected_sec", cst.connected_sec);
+    ok &= yyjson_mut_obj_add_uint(doc, jc, "bytes_tx", cst.bytes_tx);
+    ok &= yyjson_mut_obj_add_uint(doc, jc, "bytes_rx", cst.bytes_rx);
+    ok &= yyjson_mut_obj_add_int(doc, jc, "n_paths", cst.n_paths);
+    yyjson_mut_val *jpaths = yyjson_mut_obj_add_arr(doc, jc, "paths");
+    ok &= jpaths != NULL;
+    for (int p = 0; p < cst.n_paths; p++) {
+        const mqvpn_internal_client_path_t *cp = &cst.paths[p];
+        yyjson_mut_val *jp = NULL;
+        ok &= ctrl_add_path(doc, jpaths, &cp->stats, cp->reinject_tx_bytes, &jp);
+        ok &= yyjson_mut_obj_add_strcpy(doc, jp, "iface", cp->iface);
+        ok &= yyjson_mut_obj_add_str(
+            doc, jp, "status", mqvpn_path_status_string((mqvpn_path_status_t)cp->status));
+    }
+    if (!ok) {
+        yyjson_mut_doc_free(doc);
+        return ctrl_reply(NULL, resp, resp_len);
+    }
+    return ctrl_reply(doc, resp, resp_len);
+}
