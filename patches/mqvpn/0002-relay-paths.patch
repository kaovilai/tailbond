+/* The relay's address in sa: same family, address and port. */
+static int
+bind_addr_equal(const struct sockaddr *sa, socklen_t sa_len, const struct sockaddr_storage *b,
+                socklen_t b_len)
+{
+    if (sa->sa_family != b->ss_family) return 0;
+    if (sa->sa_family == AF_INET && sa_len >= (socklen_t)sizeof(struct sockaddr_in) &&
+        b_len >= (socklen_t)sizeof(struct sockaddr_in)) {
+        const struct sockaddr_in *x = (const struct sockaddr_in *)(const void *)sa;
+        const struct sockaddr_in *y = (const struct sockaddr_in *)(const void *)b;
+        return x->sin_port == y->sin_port && x->sin_addr.s_addr == y->sin_addr.s_addr;
+    }
+    if (sa->sa_family == AF_INET6 && sa_len >= (socklen_t)sizeof(struct sockaddr_in6) &&
+        b_len >= (socklen_t)sizeof(struct sockaddr_in6)) {
+        const struct sockaddr_in6 *x = (const struct sockaddr_in6 *)(const void *)sa;
+        const struct sockaddr_in6 *y = (const struct sockaddr_in6 *)(const void *)b;
+        return x->sin6_port == y->sin6_port &&
+               memcmp(&x->sin6_addr, &y->sin6_addr, sizeof(x->sin6_addr)) == 0;
+    }
+    return 0;
+}
+
 static void
 path_deliver(void *arg, const uint8_t *pkt, size_t len, const struct sockaddr *peer,
              socklen_t peer_len)
 {
     path_deliver_arg_t *a = (path_deliver_arg_t *)arg;
+    const bind_path_ctx_t *ctx = a->ctx;
+    if (ctx && ctx->relay_len) {
+        /* a relay path only hears its relay, which speaks for the server */
+        if (!ctx->peer_len || !bind_addr_equal(peer, peer_len, &ctx->relay, ctx->relay_len))
+            return;
+        peer = (const struct sockaddr *)&ctx->peer;
+        peer_len = ctx->peer_len;
+    }
     mqvpn_client_on_socket_recv(a->client, a->handle, pkt, len, peer, peer_len);
 }
 
@@ -386,6 +424,14 @@
 {
     bind_path_ctx_t *ctx = (bind_path_ctx_t *)vctx;
     if (!ctx) return MQVPN_TX_FAILED;
+    if (ctx->relay_len) {
+        if (peer && peer_len > 0 && (size_t)peer_len <= sizeof(ctx->peer)) {
+            memcpy(&ctx->peer, peer, (size_t)peer_len);
+            ctx->peer_len = peer_len;
+        }
+        return bind_send(&ctx->c, &ctx->gso_disabled, NULL, bufs, n,
+                         (const struct sockaddr *)&ctx->relay, ctx->relay_len);
+    }
     return bind_send(&ctx->c, &ctx->gso_disabled, NULL, bufs, n, peer, peer_len);
 }
 
@@ -439,6 +485,18 @@
 }
 
 int
+mqvpn_bind_posix_path_set_relay(void *vctx, const struct sockaddr *relay, socklen_t relay_len)
+{
+    bind_path_ctx_t *ctx = (bind_path_ctx_t *)vctx;
+    if (!ctx || !relay || relay_len <= 0 || (size_t)relay_len > sizeof(ctx->relay) ||
+        (relay->sa_family != AF_INET && relay->sa_family != AF_INET6))
+        return MQVPN_ERR_INVALID_ARG;
+    memcpy(&ctx->relay, relay, (size_t)relay_len);
+    ctx->relay_len = relay_len;
+    return MQVPN_OK;
+}
+
+int
 mqvpn_bind_posix_path_gro_enabled(const void *ctx)
 {
     return ctx ? ((const bind_path_ctx_t *)ctx)->c.gro_enabled : 0;
@@ -482,7 +540,7 @@
 {
     bind_path_ctx_t *ctx = (bind_path_ctx_t *)vctx;
     if (!ctx || !client) return -1;
-    path_deliver_arg_t a = {client, handle};
+    path_deliver_arg_t a = {client, handle, ctx};
     uint8_t buf[BIND_POSIX_RX_BUF];
     unsigned delivered;
     return bind_recv_one(&ctx->c, buf, handle >= 0 ? path_deliver : NULL, &a, &delivered);
@@ -494,7 +552,7 @@
 {
     bind_path_ctx_t *ctx = (bind_path_ctx_t *)vctx;
     if (!ctx || !client) return -1;
-    path_deliver_arg_t a = {client, handle};
+    path_deliver_arg_t a = {client, handle, ctx};
