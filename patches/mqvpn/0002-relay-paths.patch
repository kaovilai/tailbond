+/* NAME@HOST:PORT path specs (platform/path_spec.h) */
+static void
+test_path_spec_parse(void)
+{
+    char name[IFNAMSIZ];
+    struct sockaddr_storage via;
+    socklen_t vl = 99;
+    CHECK(platform_path_spec_parse("wlan0", name, sizeof(name), &via, &vl) == 0);
+    CHECK(strcmp(name, "wlan0") == 0 && vl == 0);
+    CHECK(platform_path_spec_parse("sh1@127.0.0.1:41234", name, sizeof(name), &via, &vl) == 1);
+    CHECK(strcmp(name, "sh1") == 0 && vl == sizeof(struct sockaddr_in));
+    const struct sockaddr_in *v4 = (const struct sockaddr_in *)(const void *)&via;
+    CHECK(v4->sin_family == AF_INET && ntohs(v4->sin_port) == 41234 &&
+          v4->sin_addr.s_addr == htonl(INADDR_LOOPBACK));
+    CHECK(platform_path_spec_parse("r6@[::1]:7", name, sizeof(name), &via, &vl) == 1);
