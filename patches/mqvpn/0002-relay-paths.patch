+/* A relay path sends to its relay whatever peer the core names, delivers
+ * the relay's datagrams as the server's, and drops anyone else's. */
+static void
+test_relay_path_sends_to_relay_and_speaks_for_the_server(void)
+{
+    struct sockaddr_in path_a, relay_a;
+    int fd = udp_socket(&path_a);
+    int relay = udp_socket(&relay_a);
+    int other = udp_socket(NULL);
+    mqvpn_bind_posix_opts_t o = opts_default();
+    void *ctx = NULL;
+    CHECK(mqvpn_bind_posix_path_new(fd, &o, &ctx) == MQVPN_OK);
+    CHECK(mqvpn_bind_posix_path_set_relay(NULL, (struct sockaddr *)&relay_a,
+                                          sizeof(relay_a)) == MQVPN_ERR_INVALID_ARG);
+    CHECK(mqvpn_bind_posix_path_set_relay(ctx, NULL, 0) == MQVPN_ERR_INVALID_ARG);
+    CHECK(mqvpn_bind_posix_path_set_relay(ctx, (struct sockaddr *)&relay_a,
+                                          sizeof(relay_a)) == MQVPN_OK);
+
+    /* the server: TEST-NET-1, never reachable, so only the relay can hear it */
+    struct sockaddr_in server;
+    memset(&server, 0, sizeof(server));
+    server.sin_family = AF_INET;
+    server.sin_port = htons(443);
+    CHECK(inet_pton(AF_INET, "192.0.2.7", &server.sin_addr) == 1);
+    uint8_t d[3] = {'Q', 1, 2};
+    mqvpn_datagram_t one[1] = {{d, sizeof(d)}};
+    CHECK(mqvpn_bind_posix_path_ops()->send(ctx, one, 1, (const struct sockaddr *)&server,
+                                            sizeof(server)) == 1);
+    wait_readable(relay);
+    uint8_t got[16];
+    struct sockaddr_in from;
+    socklen_t fl = sizeof(from);
+    CHECK(recvfrom(relay, got, sizeof(got), 0, (struct sockaddr *)&from, &fl) == 3);
+    CHECK(got[0] == 'Q' && from.sin_port == path_a.sin_port);
+
+    /* replies: the relay's is the server's; a stranger's is dropped */
+    CHECK(sendto(other, "O", 1, 0, (struct sockaddr *)&path_a, sizeof(path_a)) == 1);
+    CHECK(sendto(relay, "R", 1, 0, (struct sockaddr *)&path_a, sizeof(path_a)) == 1);
+    settle();
+    memset(&g_rx, 0, sizeof(g_rx));
+    CHECK(mqvpn_bind_posix_path_drain(ctx, (mqvpn_client_t *)(uintptr_t)1, 5, 16) == 2);
+    CHECK(g_rx.n == 1 && g_rx.handle[0] == 5 && g_rx.first[0] == 'R');
+    CHECK(g_rx.peer_port[0] == 443);
+
+    mqvpn_bind_posix_path_free(ctx);
+    close(fd);
+    close(relay);
+    close(other);
+}
