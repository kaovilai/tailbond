diff -ruN a/src/platform/path_spec.h b/src/platform/path_spec.h
--- a/src/platform/path_spec.h	1969-12-31 19:00:00.000000000 -0500
+++ b/src/platform/path_spec.h	2026-11-03 16:26:21.952624990 -0500
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 mp0rta and mqvpn contributors
+
+/*
+ * path_spec.h — a --path / [Multipath] Path value (POSIX platforms):
+ *
+ *   IFACE             bind the path's socket to interface IFACE (as before)
+ *   NAME@HOST:PORT    a relay path: not bound to an interface; its datagrams
+ *                     go to HOST:PORT instead of the server, a UDP relay that
+ *                     forwards them to the server and its replies back. NAME
+ *                     (up to IFNAMSIZ-1 bytes) labels the path in logs and
+ *                     status. HOST is a numeric IPv4 address or [IPv6].
+ *
+ * A relay path lets a device without its own uplink to the server lend one
+ * (e.g. a phone sharing its cellular data on the LAN). The relay must send
+ * the server's replies back from HOST:PORT; they are handed to the core as
+ * if they came from the server. Plain C, header only.
+ */
+#ifndef MQVPN_PLATFORM_PATH_SPEC_H
+#define MQVPN_PLATFORM_PATH_SPEC_H
+
+#include <arpa/inet.h>
+#include <net/if.h>
+#include <netinet/in.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+
+/* Parse spec. Writes the interface or label to name (NUL-terminated,
+ * truncated to name_sz-1). Returns 0 for a plain interface, 1 for a relay
+ * path (via/via_len filled), -1 for a malformed relay spec. */
+static inline int
+platform_path_spec_parse(const char *spec, char *name, size_t name_sz,
+                         struct sockaddr_storage *via, socklen_t *via_len)
+{
+    if (name_sz) name[0] = '\0';
+    if (via_len) *via_len = 0;
+    if (!spec) return -1;
+    const char *at = strchr(spec, '@');
+    if (!at) {
+        if (name_sz) snprintf(name, name_sz, "%s", spec);
+        return 0;
+    }
+    size_t nlen = (size_t)(at - spec);
+    if (nlen == 0 || nlen >= IFNAMSIZ || !via || !via_len) return -1;
+    if (name_sz) snprintf(name, name_sz, "%.*s", (int)nlen, spec);
+
+    const char *host = at + 1, *colon;
+    char hbuf[INET6_ADDRSTRLEN];
+    size_t hlen;
+    int v6 = 0;
+    if (*host == '[') {
+        const char *rb = strchr(host, ']');
+        if (!rb || rb[1] != ':') return -1;
+        host++;
+        hlen = (size_t)(rb - host);
+        colon = rb + 1;
+        v6 = 1;
+    } else {
+        colon = strrchr(host, ':');
+        if (!colon) return -1;
+        hlen = (size_t)(colon - host);
+    }
+    if (hlen == 0 || hlen >= sizeof(hbuf)) return -1;
+    memcpy(hbuf, host, hlen);
+    hbuf[hlen] = '\0';
+
+    char *end = NULL;
+    long port = strtol(colon + 1, &end, 10);
+    if (!colon[1] || !end || *end != '\0' || port < 1 || port > 65535) return -1;
+
+    memset(via, 0, sizeof(*via));
+    if (v6) {
+        struct sockaddr_in6 *s6 = (struct sockaddr_in6 *)via;
+        if (inet_pton(AF_INET6, hbuf, &s6->sin6_addr) != 1) return -1;
+        s6->sin6_family = AF_INET6;
+        s6->sin6_port = htons((unsigned short)port);
+        *via_len = sizeof(*s6);
+    } else {
+        struct sockaddr_in *s4 = (struct sockaddr_in *)via;
+        if (inet_pton(AF_INET, hbuf, &s4->sin_addr) != 1) return -1;
+        s4->sin_family = AF_INET;
+        s4->sin_port = htons((unsigned short)port);
+        *via_len = sizeof(*s4);
+    }
+    return 1;
+}
+
+#endif /* MQVPN_PLATFORM_PATH_SPEC_H */
